# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Điền MongoDB connection string của bạn tại đây khi bắt đầu Phase 3.
MONGODB_URI=

# JWT
# Thay bằng chuỗi bí mật mạnh, không commit .env thật.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Client origin (nếu frontend/backend được chạy khác origin)
CLIENT_ORIGIN=http://localhost:5000
